# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where lead notifications are delivered
CLIENT_EMAIL=ddonathan84@gmail.com

# Optional: verified sender domain in Resend
# EMAIL_FROM="David Donathan Media <leads@yourdomain.com>"

# Google Calendar Appointment Schedule embed (required for /book page)
# Google Calendar → Create → Appointment schedule → Share → Website embed → copy iframe src
NEXT_PUBLIC_GOOGLE_APPOINTMENT_URL=https://calendar.google.com/calendar/appointments/schedules/YOUR_SCHEDULE_ID?gv=true

# Optional: Google Calendar API (programmatic event creation)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REFRESH_TOKEN=your-refresh-token
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_TIMEZONE=America/Chicago
